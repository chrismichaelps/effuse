{
	"name": "@effuse/nex",
	"version": "0.1.0",
	"description": "Nex language toolkit for Effuse: lexer, AST, and parser for the Nex hierarchical API query language.",
	"author": "Chris M. Pérez",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chrismichaelps/effuse.git"
	},
	"bugs": {
		"url": "https://github.com/chrismichaelps/effuse/issues"
	},
	"homepage": "https://github.com/chrismichaelps/effuse#readme",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsup && node scripts/check-public-types.mjs && node scripts/check-build-surface.mjs",
		"dev": "tsup --watch",
		"lint": "eslint src",
		"typecheck": "tsc --noEmit",
		"pretest": "node ../../scripts/check-node-version.mjs",
		"test": "vitest run"
	},
	"keywords": [
		"effuse",
		"effuse-nex",
		"nex",
		"query-language",
		"parser",
		"lexer",
		"ast",
		"pipelines",
		"typescript",
		"type-safe",
		"effect-ts",
		"catalog",
		"schema"
	],
	"engines": {
		"node": ">=22.14.0"
	},
	"dependencies": {
		"effect": "^3.21.5"
	},
	"devDependencies": {
		"@effuse/server": "workspace:*",
		"@eslint/js": "^9.39.4",
		"@types/node": "^25.5.0",
		"eslint": "^10.0.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vitest": "^4.1.0"
	}
}
